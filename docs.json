{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GitLocalize",
  "description": "Guides, answers to frequently asked questions, and the API reference for GitLocalize — continuous localization for your GitHub repository.",
  "colors": {
    "primary": "#193b70",
    "light": "#9abcf2",
    "dark": "#0f274a"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo-dark.png",
    "href": "https://gitlocalize.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "how-it-works",
              "quickstart"
            ]
          },
          {
            "group": "Set up",
            "pages": [
              "connect-repository",
              "paths",
              "file-formats",
              "syncing"
            ]
          },
          {
            "group": "Translate",
            "pages": [
              "translating",
              "conflicts",
              "reviews",
              "glossary"
            ]
          },
          {
            "group": "Manage",
            "pages": [
              "roles",
              "visibility",
              "statistics"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Repositories",
            "pages": [
              "api-reference/repositories/list",
              "api-reference/repositories/get",
              "api-reference/repositories/languages"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "https://api.gitlocalize.com/openapi.yaml",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Contact us",
        "href": "https://gitlocalize.com/inquiries/new"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitLocalize",
      "href": "https://gitlocalize.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/gitlocalize",
      "website": "https://gitlocalize.com"
    },
    "links": [
